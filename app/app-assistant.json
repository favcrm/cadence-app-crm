{
  "contract": "app-assistant/v1",
  "app": "crm",
  "actions": [
    {
      "id": "customers.search",
      "description": "Search customers in the current CRM context.",
      "input_schema": { "type": "object", "properties": { "query": { "type": "string", "maxLength": 160 }, "limit": { "type": "integer", "minimum": 1, "maximum": 20 }, "cursor": { "type": "string", "maxLength": 256 } }, "required": [], "additionalProperties": false },
      "effect": "read",
      "confirmation": "none",
      "availability": "requires_context"
    },
    {
      "id": "customers.show",
      "description": "Show one customer from the current CRM context.",
      "input_schema": { "type": "object", "properties": { "customer_id": { "type": "string", "minLength": 1, "maxLength": 128 } }, "required": ["customer_id"], "additionalProperties": false },
      "effect": "read",
      "confirmation": "none",
      "availability": "requires_context"
    }
  ]
}
