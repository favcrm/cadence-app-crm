      "required": [
        "provenance"
      ],
      "properties": {
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "in_person",
                "web_form",
                "written",
                "imported",
                "other"
              ]
            },
            "note": {
              "type": "string",
              "maxLength": 280
            }
          }
        }
      }
    }
