                  "web_form",
                  "written",
                  "imported",
                  "other"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 280
              }
            }
          }
        ]
      }
    },
    "if": {
      "anyOf": [
        {
          "required": [
            "operation",
            "after"
          ],
          "properties": {
            "operation": {
              "const": "update"
            },
            "before": {
              "properties": {
                "consent": {
                  "properties": {
                    "email": {
                      "not": {
                        "const": "granted"
                      }
                    }
                  }
                }
              }
            },
            "after": {
              "required": [
                "consent"
              ],
              "properties": {
                "consent": {
                  "required": [
                    "email"
                  ],
                  "properties": {
                    "email": {
                      "const": "granted"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "required": [
            "operation",
            "after"
          ],
          "properties": {
            "operation": {
              "const": "update"
            },
            "before": {
              "properties": {
                "consent": {
                  "properties": {
                    "sms": {
                      "not": {
                        "const": "granted"
                      }
                    }
                  }
                }
              }
            },
            "after": {
              "required": [
                "consent"
              ],
              "properties": {
                "consent": {
                  "required": [
                    "sms"
                  ],
                  "properties": {
                    "sms": {
                      "const": "granted"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
