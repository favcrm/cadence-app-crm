  "record_search_columns": ["display_name", "email", "tags", "phone", "source"],
  "record_write_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operation",
      "before",
      "after",
      "provenance"
    ],
    "properties": {
      "operation": {
        "enum": [
          "create",
          "update"
        ]
      },
      "before": {
        "anyOf": [
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "after": {
        "type": "object"
      },
      "provenance": {
