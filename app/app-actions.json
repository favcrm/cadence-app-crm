{
  "contract": "app-actions/v1",
  "app": "crm",
  "title": "CRM customer actions",
  "summary": "Operator-reviewed customer create and partial update proposals; the host applies them only through native approval.",
  "actions": [
    {
      "id": "crm.customer.create",
      "title": "Create customer",
      "operation": "record.create",
      "record": "customer",
      "input": {
        "fields": [
          {"id": "display_name", "label": "Name", "type": "text", "required": true, "maxLength": 120},
          {"id": "email", "label": "Email", "type": "text", "maxLength": 254},
          {"id": "phone", "label": "Phone", "type": "text", "maxLength": 24},
          {"id": "tags", "label": "Tags", "type": "tags", "maxItems": 16},
          {"id": "source", "label": "Source", "type": "text", "maxLength": 40}
        ]
      }
    },
    {
      "id": "crm.customer.update",
      "title": "Update customer",
      "operation": "record.update",
      "record": "customer",
      "input": {
        "fields": [
          {"id": "display_name", "label": "Name", "type": "text", "maxLength": 120},
          {"id": "email", "label": "Email", "type": "text", "maxLength": 254},
          {"id": "phone", "label": "Phone", "type": "text", "maxLength": 24},
          {"id": "tags", "label": "Tags", "type": "tags", "maxItems": 16},
          {"id": "source", "label": "Source", "type": "text", "maxLength": 40}
        ]
      }
    }
  ]
}
