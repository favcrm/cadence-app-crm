        { "field": "email" },
        { "field": "tier", "label": "Level" },
        { "field": "visits" },
        { "field": "last_visit" },
        { "field": "tags" }
      ]
    },
    {
      "id": "segments",
      "title": "Segments",
      "kind": "table",
      "fields": [
        { "id": "name", "label": "Name", "format": "text" },
        { "id": "definition", "label": "Definition", "format": "text" },
        { "id": "members", "label": "Members", "format": "number" },
        { "id": "status", "label": "Status", "format": "enum", "values": ["active", "draft", "archived"] },
        { "id": "updated_at", "label": "Updated", "format": "datetime" }
