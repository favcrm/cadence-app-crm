        { "id": "status", "label": "Status", "format": "enum", "values": ["draft", "scheduled", "sent", "paused"] },
        { "id": "subject", "label": "Subject", "format": "text" },
        { "id": "scheduled_at", "label": "Scheduled", "format": "datetime" },
        { "id": "tags", "label": "Tags", "format": "tags", "kind": "list" }
